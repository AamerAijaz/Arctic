# Polarion server origin, with or without the /polarion/rest/v1 suffix.
POLARION_URL=https://polarion.example.com
# Personal access token from Polarion: My Account -> Personal Access Tokens.
POLARION_TOKEN=
# Optional comma-separated Polarion project ids. Empty means all projects the token can see.
# POLARION_PROJECT_ALLOWLIST=ELK,DEMO
