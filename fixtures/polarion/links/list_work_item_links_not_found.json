{
  "name": "list_work_item_links_not_found",
  "description": "404 is rewritten to 'Work item not found: {project}/{id}'.",
  "call": {
    "operation": "list_work_item_links",
    "args": {
      "project_id": "ELK",
      "work_item_id": "ELK-99"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/polarion/rest/v1/projects/ELK/workitems/ELK-99/linkedworkitems",
        "query": {
          "fields[linkedworkitems]": "role",
          "fields[workitems]": "id,title,type,status",
          "include": "workItem"
        }
      },
      "response": {
        "status": 404,
        "body": {
          "errors": [
            {
              "status": "404",
              "title": "Not Found"
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "error": {
      "type": "PolarionApiError",
      "status": 404,
      "message_contains": "Work item not found: ELK/ELK-99"
    }
  }
}
