{
  "name": "get_project_blocked_by_allowlist",
  "description": "A project outside POLARION_PROJECT_ALLOWLIST fails with 403 before any HTTP call.",
  "call": {
    "operation": "get_project",
    "args": {
      "project_id": "OTHER"
    }
  },
  "env": {
    "POLARION_PROJECT_ALLOWLIST": "ELK"
  },
  "exchanges": [],
  "expect": {
    "error": {
      "type": "PolarionApiError",
      "status": 403,
      "message_contains": "POLARION_PROJECT_ALLOWLIST"
    }
  }
}
