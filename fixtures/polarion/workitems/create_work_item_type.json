{
  "name": "create_work_item_type",
  "description": "GET the enumeration, append one option and PATCH the full options list. color/iconURL are copied from the template option (softwarerequirement > systemrequirement > requirement > last option).",
  "call": {
    "operation": "create_work_item_type",
    "args": {
      "project_id": "ELK",
      "type_id": "ux",
      "name": "UX",
      "description": "User experience requirement.",
      "dry_run": false
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/polarion/rest/v1/projects/ELK/enumerations/~/workitem-type/~",
        "query": {
          "fields[enumerations]": "@all"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "data": {
            "type": "enumerations",
            "id": "ELK/~/workitem-type/~",
            "attributes": {
              "enumName": "workitem-type",
              "options": [
                {
                  "id": "hardware",
                  "name": "hw",
                  "color": "#111111",
                  "iconURL": "/polarion/icons/default/enums/type_hardware.gif"
                },
                {
                  "id": "softwarerequirement",
                  "name": "Software Requirement",
                  "color": "#222222",
                  "iconURL": "/polarion/icons/default/enums/type_software.gif"
                }
              ]
            }
          }
        }
      }
    },
    {
      "request": {
        "method": "PATCH",
        "path": "/polarion/rest/v1/projects/ELK/enumerations/~/workitem-type/~",
        "query": {},
        "body": {
          "data": {
            "type": "enumerations",
            "id": "ELK/~/workitem-type/~",
            "attributes": {
              "options": [
                {
                  "id": "hardware",
                  "name": "hw",
                  "color": "#111111",
                  "iconURL": "/polarion/icons/default/enums/type_hardware.gif"
                },
                {
                  "id": "softwarerequirement",
                  "name": "Software Requirement",
                  "color": "#222222",
                  "iconURL": "/polarion/icons/default/enums/type_software.gif"
                },
                {
                  "id": "ux",
                  "name": "UX",
                  "description": "User experience requirement.",
                  "color": "#222222",
                  "iconURL": "/polarion/icons/default/enums/type_software.gif"
                }
              ]
            }
          }
        }
      },
      "response": {
        "status": 204
      }
    }
  ],
  "expect": {
    "result": {
      "id": "ux",
      "name": "UX",
      "description": "User experience requirement.",
      "already_exists": false
    }
  }
}
