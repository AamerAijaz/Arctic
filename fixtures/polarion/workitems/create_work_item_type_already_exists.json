{
  "name": "create_work_item_type_already_exists",
  "description": "If the type id already exists no PATCH is sent; the existing option is returned with already_exists true (its name, not the requested one).",
  "call": {
    "operation": "create_work_item_type",
    "args": {
      "project_id": "ELK",
      "type_id": "hardware",
      "name": "Hardware",
      "dry_run": false
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/polarion/rest/v1/projects/ELK/enumerations/~/workitem-type/~",
        "query": {
          "fields[enumerations]": "@all"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "data": {
            "type": "enumerations",
            "id": "ELK/~/workitem-type/~",
            "attributes": {
              "enumName": "workitem-type",
              "options": [
                {
                  "id": "hardware",
                  "name": "hw",
                  "color": "#111111",
                  "iconURL": "/polarion/icons/default/enums/type_hardware.gif"
                },
                {
                  "id": "softwarerequirement",
                  "name": "Software Requirement",
                  "color": "#222222",
                  "iconURL": "/polarion/icons/default/enums/type_software.gif"
                }
              ]
            }
          }
        }
      }
    }
  ],
  "expect": {
    "result": {
      "id": "hardware",
      "name": "hw",
      "description": null,
      "already_exists": true
    }
  }
}
