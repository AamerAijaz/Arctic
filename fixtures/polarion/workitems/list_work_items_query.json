{
  "name": "list_work_items_query",
  "description": "Lucene query is passed as 'query'; list fields omit description and assignee.",
  "call": {
    "operation": "list_work_items",
    "args": {
      "project_id": "ELK",
      "query": "type:requirement"
    }
  },
  "exchanges": [
    {
      "request": {
        "method": "GET",
        "path": "/polarion/rest/v1/projects/ELK/workitems",
        "query": {
          "fields[workitems]": "id,title,type,status",
          "page[size]": "100",
          "page[number]": "1",
          "query": "type:requirement"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "data": [
            {
              "type": "workitems",
              "id": "ELK/ELK-12",
              "attributes": {
                "title": "Login must SSO",
                "type": "requirement",
                "status": "draft"
              }
            }
          ]
        }
      }
    }
  ],
  "expect": {
    "result": [
      {
        "id": "ELK/ELK-12",
        "title": "Login must SSO",
        "type": "requirement",
        "status": "draft",
        "description": null,
        "assignee_ids": []
      }
    ]
  }
}
